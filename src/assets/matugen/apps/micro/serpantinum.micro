color-link default "{{colors.on_surface.default.hex}},{{colors.surface.default.hex}}"
color-link comment "italic {{colors.outline.default.hex}}"
color-link identifier "{{colors.secondary.default.hex}}"
color-link constant "{{colors.primary_fixed_dim.default.hex}}"
color-link constant.string "{{colors.tertiary.default.hex}}"
color-link constant.number "{{colors.tertiary_fixed_dim.default.hex}}"
color-link constant.bool "{{colors.tertiary_fixed_dim.default.hex}}"
color-link statement "{{colors.primary.default.hex}}"
color-link symbol "{{colors.on_surface_variant.default.hex}}"
color-link symbol.brackets "{{colors.outline.default.hex}}"
color-link preproc "{{colors.tertiary.default.hex}}"
color-link type "{{colors.secondary_fixed_dim.default.hex}}"
color-link special "{{colors.tertiary.default.hex}}"
color-link underlined "underline {{colors.primary.default.hex}}"
color-link error "bold {{colors.error.default.hex}}"
color-link todo "bold {{colors.on_primary.default.hex}},{{colors.primary.default.hex}}"
color-link hlsearch "{{colors.on_secondary_container.default.hex}},{{colors.secondary_container.default.hex}}"
color-link selection "{{colors.on_secondary_container.default.hex}},{{colors.secondary_container.default.hex}}"
color-link statusline "{{colors.on_surface.default.hex}},{{colors.surface_container_high.default.hex}}"
color-link statusline.inactive "{{colors.on_surface_variant.default.hex}},{{colors.surface_container_low.default.hex}}"
color-link statusline.suggestions "{{colors.on_surface.default.hex}},{{colors.surface_container_high.default.hex}}"
color-link tabbar "{{colors.on_surface_variant.default.hex}},{{colors.surface_container_low.default.hex}}"
color-link tabbar.active "bold {{colors.on_primary.default.hex}},{{colors.primary.default.hex}}"
color-link indent-char "{{colors.outline_variant.default.hex}}"
color-link line-number "{{colors.outline.default.hex}},{{colors.surface.default.hex}}"
color-link current-line-number "bold {{colors.primary.default.hex}},{{colors.surface.default.hex}}"
color-link cursor-line "{{colors.surface_container_low.default.hex}}"
color-link color-column "{{colors.surface_container_low.default.hex}}"
color-link gutter-error "{{colors.error.default.hex}}"
color-link gutter-warning "{{colors.tertiary.default.hex}}"
color-link gutter-info "{{colors.secondary.default.hex}}"
color-link diff-added "{{colors.secondary.default.hex}}"
color-link diff-modified "{{colors.tertiary.default.hex}}"
color-link diff-deleted "{{colors.error.default.hex}}"
color-link scrollbar "{{colors.outline.default.hex}}"
color-link divider "{{colors.outline_variant.default.hex}},{{colors.surface.default.hex}}"
color-link message "{{colors.on_surface.default.hex}}"
color-link error-message "bold {{colors.error.default.hex}}"
color-link match-brace "bold {{colors.on_primary.default.hex}},{{colors.primary.default.hex}}"
color-link tab-error "{{colors.error_container.default.hex}}"
color-link trailingws "{{colors.error_container.default.hex}}"
