{
  "name": "Serpantinum",
  "author": "Serpantinum",
  "variables": {
    "bg": "{{colors.surface.default.hex}}",
    "bg_low": "{{colors.surface_container_low.default.hex}}",
    "bg_high": "{{colors.surface_container_high.default.hex}}",
    "fg": "{{colors.on_surface.default.hex}}",
    "fg_variant": "{{colors.on_surface_variant.default.hex}}",
    "outline": "{{colors.outline.default.hex}}",
    "outline_variant": "{{colors.outline_variant.default.hex}}",
    "primary": "{{colors.primary.default.hex}}",
    "primary_fixed": "{{colors.primary_fixed_dim.default.hex}}",
    "secondary": "{{colors.secondary.default.hex}}",
    "secondary_fixed": "{{colors.secondary_fixed_dim.default.hex}}",
    "selection": "{{colors.secondary_container.default.hex}}",
    "tertiary": "{{colors.tertiary.default.hex}}",
    "tertiary_fixed": "{{colors.tertiary_fixed_dim.default.hex}}",
    "error": "{{colors.error.default.hex}}"
  },
  "globals": {
    "background": "var(bg)",
    "foreground": "var(fg)",
    "caret": "var(primary)",
    "line_highlight": "var(bg_low)",
    "selection": "var(selection)",
    "selection_border": "var(selection)",
    "inactive_selection": "var(bg_high)",
    "gutter": "var(bg)",
    "gutter_foreground": "var(outline)",
    "gutter_foreground_highlight": "var(primary)",
    "invisibles": "var(outline_variant)",
    "guide": "var(outline_variant)",
    "active_guide": "var(outline)",
    "stack_guide": "var(outline_variant)",
    "find_highlight": "var(primary)",
    "find_highlight_foreground": "var(bg)",
    "brackets_foreground": "var(primary)",
    "brackets_options": "underline",
    "bracket_contents_foreground": "var(primary)",
    "bracket_contents_options": "underline",
    "tags_options": "stippled_underline",
    "line_diff_added": "var(secondary)",
    "line_diff_modified": "var(tertiary)",
    "line_diff_deleted": "var(error)",
    "shadow": "var(bg_low)"
  },
  "rules": [
    { "name": "Comment", "scope": "comment, punctuation.definition.comment", "foreground": "var(outline)", "font_style": "italic" },
    { "name": "String", "scope": "string", "foreground": "var(tertiary)" },
    { "name": "Escape", "scope": "constant.character.escape, constant.other.placeholder", "foreground": "var(secondary_fixed)" },
    { "name": "Number", "scope": "constant.numeric, constant.language", "foreground": "var(tertiary_fixed)" },
    { "name": "Constant", "scope": "constant, support.constant, variable.other.constant", "foreground": "var(primary_fixed)" },
    { "name": "Keyword", "scope": "keyword, storage, storage.type, storage.modifier", "foreground": "var(primary)" },
    { "name": "Operator", "scope": "keyword.operator, punctuation.separator", "foreground": "var(fg_variant)" },
    { "name": "Punctuation", "scope": "punctuation", "foreground": "var(outline)" },
    { "name": "Function", "scope": "entity.name.function, support.function, variable.function", "foreground": "var(secondary)" },
    { "name": "Type", "scope": "entity.name.type, entity.name.class, support.type, support.class, entity.other.inherited-class", "foreground": "var(secondary_fixed)" },
    { "name": "Variable", "scope": "variable", "foreground": "var(fg)" },
    { "name": "Parameter", "scope": "variable.parameter, variable.other.member, meta.property-name", "foreground": "var(fg_variant)" },
    { "name": "Builtin", "scope": "variable.language", "foreground": "var(primary_fixed)" },
    { "name": "Tag", "scope": "entity.name.tag", "foreground": "var(primary)" },
    { "name": "Attribute", "scope": "entity.other.attribute-name", "foreground": "var(tertiary)" },
    { "name": "Preprocessor", "scope": "meta.preprocessor, keyword.control.import", "foreground": "var(tertiary)" },
    { "name": "Heading", "scope": "markup.heading, entity.name.section", "foreground": "var(primary)", "font_style": "bold" },
    { "name": "Bold", "scope": "markup.bold", "font_style": "bold" },
    { "name": "Italic", "scope": "markup.italic", "font_style": "italic" },
    { "name": "Link", "scope": "markup.underline.link", "foreground": "var(primary)", "font_style": "underline" },
    { "name": "Inserted", "scope": "markup.inserted", "foreground": "var(secondary)" },
    { "name": "Changed", "scope": "markup.changed", "foreground": "var(tertiary)" },
    { "name": "Deleted", "scope": "markup.deleted", "foreground": "var(error)" },
    { "name": "Invalid", "scope": "invalid, invalid.illegal", "foreground": "var(error)" }
  ]
}
