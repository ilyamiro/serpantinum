<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="serpantinum" name="Serpantinum" version="1.0">
  <author>Serpantinum</author>
  <description>Colors from the Serpantinum shell</description>

  <style name="text" foreground="{{colors.on_surface.default.hex}}" background="{{colors.surface.default.hex}}"/>
  <style name="selection" foreground="{{colors.on_secondary_container.default.hex}}" background="{{colors.secondary_container.default.hex}}"/>
  <style name="selection-unfocused" foreground="{{colors.on_surface.default.hex}}" background="{{colors.surface_container_high.default.hex}}"/>
  <style name="cursor" foreground="{{colors.primary.default.hex}}"/>
  <style name="secondary-cursor" foreground="{{colors.primary_container.default.hex}}"/>
  <style name="current-line" background="{{colors.surface_container_low.default.hex}}"/>
  <style name="line-numbers" foreground="{{colors.outline.default.hex}}" background="{{colors.surface.default.hex}}"/>
  <style name="current-line-number" foreground="{{colors.primary.default.hex}}" background="{{colors.surface_container_low.default.hex}}" bold="true"/>
  <style name="right-margin" foreground="{{colors.outline_variant.default.hex}}" background="{{colors.surface_container_low.default.hex}}"/>
  <style name="draw-spaces" foreground="{{colors.outline_variant.default.hex}}"/>
  <style name="background-pattern" background="{{colors.surface_container_low.default.hex}}"/>
  <style name="bracket-match" foreground="{{colors.on_primary.default.hex}}" background="{{colors.primary.default.hex}}" bold="true"/>
  <style name="bracket-mismatch" foreground="{{colors.on_error.default.hex}}" background="{{colors.error.default.hex}}"/>
  <style name="search-match" foreground="{{colors.on_tertiary_container.default.hex}}" background="{{colors.tertiary_container.default.hex}}"/>

  <style name="def:comment" foreground="{{colors.outline.default.hex}}" italic="true"/>
  <style name="def:shebang" foreground="{{colors.outline.default.hex}}" bold="true"/>
  <style name="def:doc-comment-element" italic="true"/>
  <style name="def:constant" foreground="{{colors.primary_fixed_dim.default.hex}}"/>
  <style name="def:string" foreground="{{colors.tertiary.default.hex}}"/>
  <style name="def:special-char" foreground="{{colors.secondary_fixed_dim.default.hex}}"/>
  <style name="def:number" foreground="{{colors.tertiary_fixed_dim.default.hex}}"/>
  <style name="def:boolean" foreground="{{colors.tertiary_fixed_dim.default.hex}}"/>
  <style name="def:floating-point" foreground="{{colors.tertiary_fixed_dim.default.hex}}"/>
  <style name="def:identifier" foreground="{{colors.on_surface.default.hex}}"/>
  <style name="def:function" foreground="{{colors.secondary.default.hex}}"/>
  <style name="def:builtin" foreground="{{colors.primary_fixed_dim.default.hex}}"/>
  <style name="def:statement" foreground="{{colors.primary.default.hex}}"/>
  <style name="def:keyword" foreground="{{colors.primary.default.hex}}"/>
  <style name="def:operator" foreground="{{colors.on_surface_variant.default.hex}}"/>
  <style name="def:type" foreground="{{colors.secondary_fixed_dim.default.hex}}"/>
  <style name="def:preprocessor" foreground="{{colors.tertiary.default.hex}}"/>
  <style name="def:error" foreground="{{colors.error.default.hex}}" underline="error"/>
  <style name="def:warning" foreground="{{colors.tertiary.default.hex}}"/>
  <style name="def:note" foreground="{{colors.on_primary.default.hex}}" background="{{colors.primary.default.hex}}" bold="true"/>
  <style name="def:net-address" foreground="{{colors.primary.default.hex}}" underline="single"/>
  <style name="def:underlined" underline="single"/>
  <style name="def:heading" foreground="{{colors.primary.default.hex}}" bold="true"/>
  <style name="def:emphasis" italic="true"/>
  <style name="def:strong-emphasis" bold="true"/>
  <style name="def:link-text" foreground="{{colors.primary.default.hex}}"/>
  <style name="def:insertion" foreground="{{colors.secondary.default.hex}}"/>
  <style name="def:deletion" foreground="{{colors.error.default.hex}}"/>

  <style name="diff:added-line" foreground="{{colors.secondary.default.hex}}"/>
  <style name="diff:removed-line" foreground="{{colors.error.default.hex}}"/>
  <style name="diff:changed-line" foreground="{{colors.tertiary.default.hex}}"/>
  <style name="diff:location" foreground="{{colors.primary.default.hex}}"/>
</style-scheme>
