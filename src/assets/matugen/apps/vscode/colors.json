  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": [
          "comment",
          "punctuation.definition.comment"
        ],
        "settings": {
          "foreground": "{{colors.outline.default.hex}}",
          "fontStyle": "italic"
        }
      },
      {
        "scope": [
          "string"
        ],
        "settings": {
          "foreground": "{{colors.tertiary.default.hex}}"
        }
      },
      {
        "scope": [
          "constant.character.escape",
          "constant.other.placeholder"
        ],
        "settings": {
          "foreground": "{{colors.secondary_fixed_dim.default.hex}}"
        }
      },
      {
        "scope": [
          "constant.numeric",
          "constant.language"
        ],
        "settings": {
          "foreground": "{{colors.tertiary_fixed_dim.default.hex}}"
        }
      },
      {
        "scope": [
          "constant",
          "support.constant",
          "variable.other.constant"
        ],
        "settings": {
          "foreground": "{{colors.primary_fixed_dim.default.hex}}"
        }
      },
      {
        "scope": [
          "keyword",
          "storage",
          "storage.type",
          "storage.modifier"
        ],
        "settings": {
          "foreground": "{{colors.primary.default.hex}}"
        }
      },
      {
        "scope": [
          "keyword.operator",
          "punctuation.separator"
        ],
        "settings": {
          "foreground": "{{colors.on_surface_variant.default.hex}}"
        }
      },
      {
        "scope": [
          "punctuation"
        ],
        "settings": {
          "foreground": "{{colors.outline.default.hex}}"
        }
      },
      {
        "scope": [
          "entity.name.function",
          "support.function",
          "variable.function",
          "meta.function-call"
        ],
        "settings": {
          "foreground": "{{colors.secondary.default.hex}}"
        }
      },
      {
        "scope": [
          "entity.name.type",
          "entity.name.class",
          "support.type",
          "support.class",
          "entity.other.inherited-class"
        ],
        "settings": {
          "foreground": "{{colors.secondary_fixed_dim.default.hex}}"
        }
      },
      {
        "scope": [
          "variable",
          "meta.definition.variable"
        ],
        "settings": {
          "foreground": "{{colors.on_surface.default.hex}}"
        }
      },
      {
        "scope": [
          "variable.parameter",
          "variable.other.property",
          "meta.property-name",
          "support.type.property-name"
        ],
        "settings": {
          "foreground": "{{colors.on_surface_variant.default.hex}}"
        }
      },
      {
        "scope": [
          "variable.language"
        ],
        "settings": {
          "foreground": "{{colors.primary_fixed_dim.default.hex}}"
        }
      },
      {
        "scope": [
          "entity.name.tag"
        ],
        "settings": {
          "foreground": "{{colors.primary.default.hex}}"
        }
      },
      {
        "scope": [
          "entity.other.attribute-name"
        ],
        "settings": {
          "foreground": "{{colors.tertiary.default.hex}}"
        }
      },
      {
        "scope": [
          "meta.preprocessor",
          "keyword.control.import",
          "entity.name.function.preprocessor"
        ],
        "settings": {
          "foreground": "{{colors.tertiary.default.hex}}"
        }
      },
      {
        "scope": [
          "markup.heading",
          "entity.name.section"
        ],
        "settings": {
          "foreground": "{{colors.primary.default.hex}}",
          "fontStyle": "bold"
        }
      },
      {
        "scope": [
          "markup.bold"
        ],
        "settings": {
          "fontStyle": "bold"
        }
      },
      {
        "scope": [
          "markup.italic"
        ],
        "settings": {
          "fontStyle": "italic"
        }
      },
      {
        "scope": [
          "markup.underline.link"
        ],
        "settings": {
          "foreground": "{{colors.primary.default.hex}}",
          "fontStyle": "underline"
        }
      },
      {
        "scope": [
          "markup.inserted"
        ],
        "settings": {
          "foreground": "{{colors.secondary.default.hex}}"
        }
      },
      {
        "scope": [
          "markup.changed"
        ],
        "settings": {
          "foreground": "{{colors.tertiary.default.hex}}"
        }
      },
      {
        "scope": [
          "markup.deleted"
        ],
        "settings": {
          "foreground": "{{colors.error.default.hex}}"
        }
      },
      {
        "scope": [
          "invalid",
          "invalid.illegal"
        ],
        "settings": {
          "foreground": "{{colors.error.default.hex}}"
        }
      }
    ]
  }
}
