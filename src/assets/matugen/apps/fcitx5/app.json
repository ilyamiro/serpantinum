{
  "name": "Fcitx5",
  "category": "system",
  "icon": "󰌌",
  "detect": {
    "bin": [
      "fcitx5"
    ]
  },
  "templates": [
    {
      "input": "theme.conf",
      "output": "$XDG_DATA_HOME/fcitx5/themes/serpantinum/theme.conf"
    }
  ],
  "integrate": [
    {
      "type": "ini",
      "file": "$XDG_CONFIG_HOME/fcitx5/conf/classicui.conf",
      "values": {
        "": {
          "Theme": "serpantinum",
          "DarkTheme": "serpantinum"
        }
      },
      "create": true
    }
  ],
  "reload": [
    "busctl --user call org.fcitx.Fcitx5 /controller org.fcitx.Fcitx.Controller1 ReloadAddonConfig s classicui >/dev/null 2>&1; true"
  ]
}
