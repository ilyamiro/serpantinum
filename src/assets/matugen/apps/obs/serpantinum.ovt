@OBSThemeMeta {
    name: 'Serpantinum';
    id: 'com.serpantinum.theme';
    extends: 'com.obsproject.Yami';
    author: 'Serpantinum';
    dark: 'true';
}

@OBSThemeVars {
    --grey1: {{colors.outline.default.hex}};
    --grey2: {{colors.outline_variant.default.hex}};
    --grey3: {{colors.surface_container_highest.default.hex}};
    --grey4: {{colors.surface_container_high.default.hex}};
    --grey5: {{colors.surface_container.default.hex}};
    --grey6: {{colors.surface_container_low.default.hex}};
    --grey7: {{colors.surface.default.hex}};
    --grey8: {{colors.surface_container_lowest.default.hex}};

    --primary: {{colors.primary_container.default.hex}};
    --primary_light: {{colors.primary.default.hex}};
    --primary_lighter: {{colors.primary_fixed_dim.default.hex}};
    --primary_dark: {{colors.on_primary.default.hex}};
    --primary_darker: {{colors.on_primary_fixed.default.hex}};

    --warning: {{colors.tertiary.default.hex}};
    --danger: {{colors.error.default.hex}};

    --bg_window: {{colors.surface_container_low.default.hex}};
    --bg_base: {{colors.surface_container.default.hex}};
    --bg_preview: {{colors.surface_container_lowest.default.hex}};

    --text: {{colors.on_surface.default.hex}};
    --text_light: {{colors.on_surface_variant.default.hex}};
    --text_muted: {{colors.outline.default.hex}};
    --text_disabled: {{colors.outline_variant.default.hex}};
    --text_inactive: {{colors.on_surface_variant.default.hex}};

    --highlight_color: {{colors.primary.default.hex}};
    --border_highlight: {{colors.primary.default.hex}};
}
