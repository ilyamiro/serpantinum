{
  "name": "Heroic Games Launcher",
  "category": "apps",
  "icon": "󰊗",
  "hint": "heroic",
  "detect": {
    "path": [
      "$XDG_CONFIG_HOME/heroic",
      "$HOME/.var/app/com.heroicgameslauncher.hgl/config/heroic"
    ]
  },
  "templates": [
    {
      "input": "serpantinum.css",
      "output": "$XDG_CONFIG_HOME/heroic/themes/serpantinum.css",
