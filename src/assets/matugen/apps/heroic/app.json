        "path": [
          "$XDG_CONFIG_HOME/heroic"
        ]
      }
    },
    {
      "input": "serpantinum.css",
      "output": "$HOME/.var/app/com.heroicgameslauncher.hgl/config/heroic/themes/serpantinum.css",
      "when": {
        "path": [
          "$HOME/.var/app/com.heroicgameslauncher.hgl/config/heroic"
        ]
      }
    }
  ]
}
