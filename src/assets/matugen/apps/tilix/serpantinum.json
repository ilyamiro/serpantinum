{
  "name": "Serpantinum",
  "comment": "Colors from the Serpantinum shell",
  "use-theme-colors": false,
  "foreground-color": "{{colors.on_surface.default.hex}}",
  "background-color": "{{colors.surface_container.default.hex}}",
  "use-cursor-color": true,
  "cursor-background-color": "{{colors.primary.default.hex}}",
  "cursor-foreground-color": "{{colors.on_primary.default.hex}}",
  "use-highlight-color": true,
  "highlight-background-color": "{{colors.secondary_container.default.hex}}",
  "highlight-foreground-color": "{{colors.on_secondary_container.default.hex}}",
  "use-badge-color": true,
  "badge-color": "{{colors.tertiary.default.hex}}",
  "use-bold-color": false,
  "palette": [
    "{{colors.surface_variant.default.hex}}",
    "{{colors.error.default.hex}}",
    "{{colors.primary.default.hex}}",
    "{{colors.tertiary.default.hex}}",
    "{{colors.secondary.default.hex}}",
    "{{colors.primary_container.default.hex}}",
    "{{colors.secondary_container.default.hex}}",
    "{{colors.on_surface_variant.default.hex}}",
    "{{colors.outline.default.hex}}",
    "{{colors.error_container.default.hex}}",
    "{{colors.primary_fixed.default.hex}}",
    "{{colors.tertiary_fixed.default.hex}}",
    "{{colors.secondary_fixed.default.hex}}",
    "{{colors.inverse_primary.default.hex}}",
    "{{colors.tertiary_container.default.hex}}",
    "{{colors.on_surface.default.hex}}"
  ]
}
