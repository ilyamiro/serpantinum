face global value rgb:{{colors.primary_fixed_dim.default.hex_stripped}}
face global type rgb:{{colors.secondary_fixed_dim.default.hex_stripped}}
face global variable rgb:{{colors.on_surface.default.hex_stripped}}
face global module rgb:{{colors.tertiary.default.hex_stripped}}
face global function rgb:{{colors.secondary.default.hex_stripped}}
