{
  "name": "OpenCode",
  "category": "tools",
  "icon": "󰚩",
  "detect": {
    "bin": [
      "opencode"
    ]
  },
  "templates": [
    {
      "input": "serpantinum.json",
      "output": "$XDG_CONFIG_HOME/opencode/themes/serpantinum.json"
    }
  ],
  "integrate": [
    {
      "type": "json",
      "file": [
        "$XDG_CONFIG_HOME/opencode/opencode.json",
        "$XDG_CONFIG_HOME/opencode/opencode.jsonc",
        "$XDG_CONFIG_HOME/opencode/config.json"
      ],
      "create_at": "$XDG_CONFIG_HOME/opencode/opencode.json",
      "values": {
        "theme": "serpantinum"
      },
      "create": true
    }
  ]
}
