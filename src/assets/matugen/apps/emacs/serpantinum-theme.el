;;; serpantinum-theme.el -*- lexical-binding: t -*-

(deftheme serpantinum "Colors from the Serpantinum shell.")

(let ((class '((class color) (min-colors 89)))
      (bg "{{colors.surface.default.hex}}")
      (bg-low "{{colors.surface_container_low.default.hex}}")
      (bg-mid "{{colors.surface_container.default.hex}}")
      (bg-high "{{colors.surface_container_high.default.hex}}")
      (bg-highest "{{colors.surface_container_highest.default.hex}}")
      (fg "{{colors.on_surface.default.hex}}")
      (fg-variant "{{colors.on_surface_variant.default.hex}}")
      (outline "{{colors.outline.default.hex}}")
      (outline-variant "{{colors.outline_variant.default.hex}}")
      (primary "{{colors.primary.default.hex}}")
      (on-primary "{{colors.on_primary.default.hex}}")
      (primary-container "{{colors.primary_container.default.hex}}")
      (on-primary-container "{{colors.on_primary_container.default.hex}}")
      (primary-fixed "{{colors.primary_fixed_dim.default.hex}}")
      (secondary "{{colors.secondary.default.hex}}")
      (secondary-container "{{colors.secondary_container.default.hex}}")
      (on-secondary-container "{{colors.on_secondary_container.default.hex}}")
      (secondary-fixed "{{colors.secondary_fixed_dim.default.hex}}")
      (tertiary "{{colors.tertiary.default.hex}}")
      (tertiary-container "{{colors.tertiary_container.default.hex}}")
      (on-tertiary-container "{{colors.on_tertiary_container.default.hex}}")
      (tertiary-fixed "{{colors.tertiary_fixed_dim.default.hex}}")
      (err "{{colors.error.default.hex}}")
      (err-container "{{colors.error_container.default.hex}}")
      (on-err-container "{{colors.on_error_container.default.hex}}"))
  (custom-theme-set-faces
   'serpantinum
   `(default ((,class (:foreground ,fg :background ,bg))))
   `(cursor ((,class (:background ,primary))))
   `(fringe ((,class (:background ,bg))))
   `(region ((,class (:foreground ,on-secondary-container :background ,secondary-container :extend t))))
   `(secondary-selection ((,class (:background ,bg-highest :extend t))))
   `(highlight ((,class (:background ,bg-high))))
   `(hl-line ((,class (:background ,bg-low :extend t))))
   `(line-number ((,class (:foreground ,outline :background ,bg))))
   `(line-number-current-line ((,class (:foreground ,primary :background ,bg-low :weight bold))))
   `(minibuffer-prompt ((,class (:foreground ,primary :weight bold))))
   `(vertical-border ((,class (:foreground ,outline-variant))))
   `(window-divider ((,class (:foreground ,outline-variant))))
   `(link ((,class (:foreground ,primary :underline t))))
   `(link-visited ((,class (:foreground ,tertiary :underline t))))
   `(shadow ((,class (:foreground ,outline))))
   `(error ((,class (:foreground ,err :weight bold))))
   `(warning ((,class (:foreground ,tertiary :weight bold))))
   `(success ((,class (:foreground ,secondary :weight bold))))
   `(match ((,class (:foreground ,on-tertiary-container :background ,tertiary-container))))
   `(isearch ((,class (:foreground ,on-primary :background ,primary :weight bold))))
   `(lazy-highlight ((,class (:foreground ,on-secondary-container :background ,secondary-container))))
   `(isearch-fail ((,class (:foreground ,on-err-container :background ,err-container))))
   `(show-paren-match ((,class (:foreground ,primary :background ,bg-highest :weight bold))))
   `(show-paren-mismatch ((,class (:foreground ,on-err-container :background ,err-container))))
   `(trailing-whitespace ((,class (:background ,err-container))))
   `(whitespace-space ((,class (:foreground ,outline-variant))))
   `(whitespace-tab ((,class (:foreground ,outline-variant))))
   `(mode-line ((,class (:foreground ,fg :background ,bg-high :box (:line-width 4 :color ,bg-high)))))
   `(mode-line-inactive ((,class (:foreground ,fg-variant :background ,bg-low :box (:line-width 4 :color ,bg-low)))))
   `(mode-line-buffer-id ((,class (:foreground ,primary :weight bold))))
   `(header-line ((,class (:foreground ,fg :background ,bg-mid))))
   `(tab-bar ((,class (:foreground ,fg-variant :background ,bg-low))))
   `(tab-bar-tab ((,class (:foreground ,on-primary-container :background ,primary-container :weight bold))))
   `(tab-bar-tab-inactive ((,class (:foreground ,fg-variant :background ,bg-low))))
   `(tab-line ((,class (:foreground ,fg-variant :background ,bg-low))))
   `(tooltip ((,class (:foreground ,fg :background ,bg-high))))
   `(font-lock-comment-face ((,class (:foreground ,outline :slant italic))))
   `(font-lock-comment-delimiter-face ((,class (:foreground ,outline :slant italic))))
   `(font-lock-doc-face ((,class (:foreground ,fg-variant :slant italic))))
   `(font-lock-string-face ((,class (:foreground ,tertiary))))
   `(font-lock-keyword-face ((,class (:foreground ,primary))))
   `(font-lock-builtin-face ((,class (:foreground ,primary-fixed))))
   `(font-lock-constant-face ((,class (:foreground ,primary-fixed))))
   `(font-lock-function-name-face ((,class (:foreground ,secondary))))
   `(font-lock-variable-name-face ((,class (:foreground ,fg))))
   `(font-lock-type-face ((,class (:foreground ,secondary-fixed))))
   `(font-lock-preprocessor-face ((,class (:foreground ,tertiary))))
   `(font-lock-negation-char-face ((,class (:foreground ,err))))
   `(font-lock-warning-face ((,class (:foreground ,err :weight bold))))
   `(font-lock-number-face ((,class (:foreground ,tertiary-fixed))))
   `(font-lock-operator-face ((,class (:foreground ,fg-variant))))
   `(font-lock-punctuation-face ((,class (:foreground ,outline))))
   `(font-lock-escape-face ((,class (:foreground ,secondary-fixed))))
   `(completions-common-part ((,class (:foreground ,primary :weight bold))))
   `(completions-first-difference ((,class (:foreground ,tertiary))))
   `(diff-added ((,class (:foreground ,on-secondary-container :background ,secondary-container :extend t))))
   `(diff-removed ((,class (:foreground ,on-err-container :background ,err-container :extend t))))
   `(diff-changed ((,class (:background ,bg-mid :extend t))))
   `(diff-header ((,class (:foreground ,fg-variant :background ,bg-low :extend t))))
   `(diff-file-header ((,class (:foreground ,primary :background ,bg-low :weight bold :extend t))))
   `(diff-hunk-header ((,class (:foreground ,tertiary :background ,bg-low :extend t))))
   `(org-level-1 ((,class (:foreground ,primary :weight bold :height 1.2))))
   `(org-level-2 ((,class (:foreground ,secondary :weight bold :height 1.1))))
   `(org-level-3 ((,class (:foreground ,tertiary :weight bold))))
   `(org-level-4 ((,class (:foreground ,primary-fixed :weight bold))))
   `(org-block ((,class (:background ,bg-low :extend t))))
   `(org-block-begin-line ((,class (:foreground ,outline :background ,bg-low :extend t))))
   `(org-block-end-line ((,class (:foreground ,outline :background ,bg-low :extend t))))
   `(org-code ((,class (:foreground ,tertiary))))
   `(org-verbatim ((,class (:foreground ,secondary))))
   `(org-todo ((,class (:foreground ,err :weight bold))))
   `(org-done ((,class (:foreground ,secondary :weight bold))))
   `(org-date ((,class (:foreground ,tertiary :underline t))))
   `(org-link ((,class (:foreground ,primary :underline t))))
   `(magit-section-highlight ((,class (:background ,bg-low :extend t))))
   `(magit-branch-local ((,class (:foreground ,secondary))))
   `(magit-branch-remote ((,class (:foreground ,tertiary))))
   `(magit-hash ((,class (:foreground ,outline))))
   `(vertico-current ((,class (:foreground ,on-secondary-container :background ,secondary-container :extend t))))
   `(corfu-default ((,class (:foreground ,fg :background ,bg-high))))
   `(corfu-current ((,class (:foreground ,on-secondary-container :background ,secondary-container))))
   `(company-tooltip ((,class (:foreground ,fg :background ,bg-high))))
   `(company-tooltip-selection ((,class (:foreground ,on-secondary-container :background ,secondary-container))))
   `(company-tooltip-common ((,class (:foreground ,primary :weight bold))))))

(provide-theme 'serpantinum)
