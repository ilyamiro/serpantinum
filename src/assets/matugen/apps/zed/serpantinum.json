{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Serpantinum",
  "author": "Serpantinum",
  "themes": [
    {
      "name": "Serpantinum",
      "appearance": "{{mode}}",
      "style": {
        "background": "{{colors.surface_container.default.hex}}",
        "surface.background": "{{colors.surface_container_low.default.hex}}",
        "elevated_surface.background": "{{colors.surface_container_high.default.hex}}",
        "panel.background": "{{colors.surface_container_low.default.hex}}",
        "panel.focused_border": "{{colors.primary.default.hex}}",
        "editor.background": "{{colors.surface.default.hex}}",
        "editor.foreground": "{{colors.on_surface.default.hex}}",
        "editor.gutter.background": "{{colors.surface.default.hex}}",
        "editor.active_line.background": "{{colors.surface_container_low.default.hex}}",
        "editor.highlighted_line.background": "{{colors.surface_container.default.hex}}",
        "editor.line_number": "{{colors.outline.default.hex}}",
        "editor.active_line_number": "{{colors.primary.default.hex}}",
        "editor.indent_guide": "{{colors.outline_variant.default.hex}}",
        "editor.indent_guide_active": "{{colors.outline.default.hex}}",
        "editor.invisible": "{{colors.outline_variant.default.hex}}",
        "editor.wrap_guide": "{{colors.outline_variant.default.hex}}",
        "editor.document_highlight.read_background": "{{colors.surface_container_high.default.hex}}",
        "editor.document_highlight.write_background": "{{colors.surface_container_highest.default.hex}}",
        "tab_bar.background": "{{colors.surface_container_low.default.hex}}",
        "tab.active_background": "{{colors.surface.default.hex}}",
        "tab.inactive_background": "{{colors.surface_container_low.default.hex}}",
        "title_bar.background": "{{colors.surface_container.default.hex}}",
        "title_bar.inactive_background": "{{colors.surface_container_low.default.hex}}",
        "toolbar.background": "{{colors.surface.default.hex}}",
        "status_bar.background": "{{colors.surface_container.default.hex}}",
        "scrollbar.thumb.background": "{{colors.outline_variant.default.hex}}",
        "scrollbar.thumb.hover_background": "{{colors.outline.default.hex}}",
        "scrollbar.track.background": "{{colors.surface.default.hex}}",
        "border": "{{colors.outline_variant.default.hex}}",
        "border.variant": "{{colors.surface_container_highest.default.hex}}",
        "border.focused": "{{colors.primary.default.hex}}",
        "border.selected": "{{colors.primary.default.hex}}",
        "element.background": "{{colors.surface_container_high.default.hex}}",
        "element.hover": "{{colors.surface_container_highest.default.hex}}",
        "element.active": "{{colors.secondary_container.default.hex}}",
        "element.selected": "{{colors.secondary_container.default.hex}}",
        "ghost_element.hover": "{{colors.surface_container_high.default.hex}}",
        "ghost_element.active": "{{colors.surface_container_highest.default.hex}}",
        "ghost_element.selected": "{{colors.secondary_container.default.hex}}",
        "text": "{{colors.on_surface.default.hex}}",
        "text.muted": "{{colors.on_surface_variant.default.hex}}",
        "text.placeholder": "{{colors.outline.default.hex}}",
        "text.accent": "{{colors.primary.default.hex}}",
        "icon": "{{colors.on_surface.default.hex}}",
        "icon.muted": "{{colors.on_surface_variant.default.hex}}",
        "icon.accent": "{{colors.primary.default.hex}}",
        "link_text.hover": "{{colors.primary.default.hex}}",
        "search.match_background": "{{colors.secondary_container.default.hex}}",
        "drop_target.background": "{{colors.primary_container.default.hex}}",
        "error": "{{colors.error.default.hex}}",
        "warning": "{{colors.tertiary.default.hex}}",
        "info": "{{colors.secondary.default.hex}}",
        "hint": "{{colors.outline.default.hex}}",
        "success": "{{colors.secondary.default.hex}}",
        "created": "{{colors.secondary.default.hex}}",
        "modified": "{{colors.tertiary.default.hex}}",
        "deleted": "{{colors.error.default.hex}}",
        "conflict": "{{colors.error.default.hex}}",
        "ignored": "{{colors.outline.default.hex}}",
        "terminal.background": "{{colors.surface.default.hex}}",
        "terminal.foreground": "{{colors.on_surface.default.hex}}",
        "terminal.ansi.black": "{{colors.surface_variant.default.hex}}",
        "terminal.ansi.red": "{{colors.error.default.hex}}",
        "terminal.ansi.green": "{{colors.primary.default.hex}}",
        "terminal.ansi.yellow": "{{colors.tertiary.default.hex}}",
        "terminal.ansi.blue": "{{colors.secondary.default.hex}}",
        "terminal.ansi.magenta": "{{colors.primary_container.default.hex}}",
        "terminal.ansi.cyan": "{{colors.secondary_container.default.hex}}",
        "terminal.ansi.white": "{{colors.on_surface_variant.default.hex}}",
        "terminal.ansi.bright_black": "{{colors.outline.default.hex}}",
        "terminal.ansi.bright_red": "{{colors.error_container.default.hex}}",
        "terminal.ansi.bright_green": "{{colors.primary_fixed.default.hex}}",
        "terminal.ansi.bright_yellow": "{{colors.tertiary_fixed.default.hex}}",
        "terminal.ansi.bright_blue": "{{colors.secondary_fixed.default.hex}}",
        "terminal.ansi.bright_magenta": "{{colors.inverse_primary.default.hex}}",
        "terminal.ansi.bright_cyan": "{{colors.tertiary_container.default.hex}}",
        "terminal.ansi.bright_white": "{{colors.on_surface.default.hex}}",
        "players": [
          { "cursor": "{{colors.primary.default.hex}}", "background": "{{colors.primary.default.hex}}", "selection": "{{colors.secondary_container.default.hex}}" }
        ],
        "syntax": {
          "comment": { "color": "{{colors.outline.default.hex}}", "font_style": "italic" },
          "keyword": { "color": "{{colors.primary.default.hex}}" },
          "function": { "color": "{{colors.secondary.default.hex}}" },
          "string": { "color": "{{colors.tertiary.default.hex}}" },
          "number": { "color": "{{colors.tertiary_fixed_dim.default.hex}}" },
          "boolean": { "color": "{{colors.tertiary_fixed_dim.default.hex}}" },
          "constant": { "color": "{{colors.primary_fixed_dim.default.hex}}" },
          "type": { "color": "{{colors.secondary_fixed_dim.default.hex}}" },
          "variable": { "color": "{{colors.on_surface.default.hex}}" },
          "property": { "color": "{{colors.on_surface_variant.default.hex}}" },
          "operator": { "color": "{{colors.on_surface_variant.default.hex}}" },
          "punctuation": { "color": "{{colors.outline.default.hex}}" },
          "tag": { "color": "{{colors.primary.default.hex}}" },
          "attribute": { "color": "{{colors.tertiary.default.hex}}" },
          "title": { "color": "{{colors.primary.default.hex}}", "font_weight": 700 },
          "link_uri": { "color": "{{colors.tertiary.default.hex}}" },
          "emphasis": { "font_style": "italic" },
          "emphasis.strong": { "font_weight": 700 }
        }
      }
    }
  ]
}
