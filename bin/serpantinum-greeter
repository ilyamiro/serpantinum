#!/usr/bin/env bash

BIN_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
if [ -z "${SERPANTINUM_DIR:-}" ]; then
    export SERPANTINUM_DIR="$(dirname "$BIN_DIR")/src"
fi

GREETER_DIR="${SERPANTINUM_GREETER_DIR:-/var/lib/serpantinum-greeter}"
GREETER_QML="$SERPANTINUM_DIR/quickshell/GreeterShell.qml"

get_installed_version() {
    local version_file="${XDG_STATE_HOME:-$HOME/.local/state}/serpantinum/version"
    local ver=""
    if [ -f "$version_file" ]; then
        ver=$(awk -F= '/^SERPANTINUM_VERSION=/{gsub(/["'\'' ]/, "", $2); print $2}' "$version_file")
    fi
    if [ -z "$ver" ] && [ -n "$SERPANTINUM_VERSION" ]; then
        ver="$SERPANTINUM_VERSION"
    fi
    if [ -z "$ver" ]; then
        if [ -n "$SERPANTINUM_DIR" ] && [ -f "$SERPANTINUM_DIR/version.txt" ]; then
            ver=$(cat "$SERPANTINUM_DIR/version.txt" 2>/dev/null | xargs)
        elif [ -f "$(dirname "$BIN_DIR")/version.txt" ]; then
            ver=$(cat "$(dirname "$BIN_DIR")/version.txt" 2>/dev/null | xargs)
        elif [ -n "$SERPANTINUM_DIR" ] && [ -f "$(dirname "$SERPANTINUM_DIR")/version.txt" ]; then
            ver=$(cat "$(dirname "$SERPANTINUM_DIR")/version.txt" 2>/dev/null | xargs)
        fi
    fi
    if [ -z "$ver" ]; then
        ver="2.0.0"
    fi
    echo "$ver"
}

show_help() {
    source "$SERPANTINUM_DIR/scripts/i18n.sh" 2>/dev/null
    echo "$(t "greeter.cli.usage")"
    echo ""
    echo "$(t "greeter.cli.description")"
    echo ""
    echo "$(t "daemon.cli.commands")"
    echo "  run                                  $(t "greeter.cli.cmd_run")"
    echo "  test                                 $(t "greeter.cli.cmd_test")"
    echo "  sync                                 $(t "greeter.cli.cmd_sync")"
    echo ""
    echo "$(t "daemon.cli.options")"
    echo "  -V, --version                        $(t "daemon.cli.opt_version")"
    echo "  -h, --help                           $(t "daemon.cli.opt_help")"
    echo ""
    echo "$(t "greeter.cli.environment")"
    echo "  SERPANTINUM_GREETER_USER             $(t "greeter.cli.env_user")"
    echo "  SERPANTINUM_GREETER_SESSION          $(t "greeter.cli.env_session" DEFAULT="start-hyprland")"
    echo "  SERPANTINUM_GREETER_SESSION_DESKTOP  $(t "greeter.cli.env_session_desktop" DEFAULT="Hyprland")"
    echo "  SERPANTINUM_GREETER_HYBRID_AUTH      $(t "greeter.cli.env_hybrid_auth")"
    echo "  SERPANTINUM_GREETER_DIR              $(t "greeter.cli.env_dir" DEFAULT="/var/lib/serpantinum-greeter")"
    echo ""
    echo "$(t "greeter.cli.sync_note")"
}

run_quickshell() {
    QT_LOGGING_RULES='*.debug=false' qs --no-detailed-logs -p "$GREETER_QML"
}

exit_compositor() {
    if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
        hyprctl dispatch 'hl.dsp.exit()' >/dev/null 2>&1 || hyprctl dispatch exit >/dev/null 2>&1
    elif [ -n "${NIRI_SOCKET:-}" ]; then
        niri msg action quit --skip-confirmation >/dev/null 2>&1
    elif [ -n "${SWAYSOCK:-}" ]; then
        swaymsg exit >/dev/null 2>&1
    fi
}

cmd_run() {
    if command -v systemd-cat >/dev/null 2>&1; then
        exec > >(systemd-cat -t serpantinum-greeter) 2>&1
    fi

    if [ -z "${SERPANTINUM_GREETER_USER:-}" ]; then
        echo "SERPANTINUM_GREETER_USER is not set"
        exit_compositor
        exit 1
    fi

    export HOME="$GREETER_DIR/home"
    export USER="$SERPANTINUM_GREETER_USER"

    echo "Start (uid $(id -u), user $USER, WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-})"
    run_quickshell
    echo "qs exited with code $?"

    exit_compositor
}

cmd_test() {
    export SERPANTINUM_GREETER_USER="${SERPANTINUM_GREETER_USER:-${USER:-}}"
    unset GREETD_SOCK
    run_quickshell
}

cmd_sync() {
    umask 022
    local M="$GREETER_DIR/home"
    [ -w "$M" ] || { echo "$M is missing or not writable"; exit 0; }

    local config="${XDG_CONFIG_HOME:-$HOME/.config}/serpantinum"
    local cache="${XDG_CACHE_HOME:-$HOME/.cache}/serpantinum"
    local state="${XDG_STATE_HOME:-$HOME/.local/state}/serpantinum"

    copy() {
        [ -f "$1" ] || return 0
        install -D -m 0644 "$1" "$M/$2.tmp" && mv -f "$M/$2.tmp" "$M/$2"
    }

    copy "$config/settings.json" .config/serpantinum/settings.json

    local f
    for f in "$cache"/wallpaper/current_wallpaper*.png; do
        copy "$f" ".cache/serpantinum/wallpaper/$(basename "$f")"
    done
    copy "$cache/avatar/avatar_cropped.png" .cache/serpantinum/avatar/avatar_cropped.png
    copy "$cache/weather/weather.json" .cache/serpantinum/weather/weather.json

    for f in qs_matugen_colors.json qs_colors.json lockscreen/layout.json; do
        copy "$state/$f" ".local/state/serpantinum/$f"
    done

    local avatar
    avatar=$(jq -r '.general.avatarPath // empty' "$config/settings.json" 2>/dev/null)
    if [ -n "$avatar" ] && [ -f "$avatar" ]; then
        copy "$avatar" .face
    else
        copy "$HOME/.face" .face
    fi
}

case "${1:-run}" in
    run) cmd_run ;;
    test) cmd_test ;;
    sync) cmd_sync ;;
    -V | --version) echo "serpantinum-greeter v$(get_installed_version)" ;;
    -h | --help | help) show_help ;;
    *)
        source "$SERPANTINUM_DIR/scripts/i18n.sh" 2>/dev/null
        echo "$(t "daemon.cli.unknown_arg" ARG="$1")"
        show_help
        exit 1
        ;;
esac
